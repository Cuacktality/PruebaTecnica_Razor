@page
@model PruebaTecnica.Pages.Users.CreateModel

@{
    ViewData["Title"] = "Crear Usuario"; 
    var role = Request.Query["role"].ToString();
}

<div class="container py-5">
    <div class="card shadow border-0 mx-auto" style="max-width: 800px;">
        <div class="card-header @(role == "Seeker" ? "bg-success" : "bg-info") text-white text-center py-3">
            <h4 class="mb-0">Registrarse como @(role == "Seeker" ? "Candidato" : "Empresa")</h4>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" name="roleStr" value="@role" />

                <h5 class="text-secondary border-bottom pb-2 mb-3">Datos de Cuenta</h5>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Nombre Completo</label>
                        <input name="FullName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="Pass" class="form-control" required />
                    </div>
                </div>

                @if (role == "Seeker") {
                    <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Información Profesional</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Edad</label>
                            <input type="number" name="Age" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Teléfono</label>
                            <input name="ContactNumber" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Nivel Educativo</label>
                            <select name="ELevel" class="form-select" required>
                                <option value="1">Técnico</option>
                                <option value="2">Tecnólogo</option>
                                <option value="3">Universitario</option>
                                <option value="4">Postgrado</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Experiencia Laboral</label>
                            <textarea name="WorkXP" class="form-control" rows="2" required></textarea>
                        </div>
                    </div>
                }
                else {
                    <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Información de Empresa</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ubicación</label>
                            <input name="Location" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Industria</label>
                            <input name="Industry" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Número de Empleados</label>
                            <input type="number" name="EmployeeCount" class="form-control" required />
                        </div>
                    </div>
                }

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn @(role == "Seeker" ? "btn-success" : "btn-info text-white") rounded-pill shadow">
                        Crear Mi Cuenta Ahora
                    </button>
                    <a asp-page="/Index" class="btn btn-link text-muted btn-sm">Ya tengo cuenta, iniciar sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
