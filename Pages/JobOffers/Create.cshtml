@page
@model PruebaTecnica.Pages.JobOffers.CreateModel
@{
    ViewData["Title"] = "Publicar Vacante";
}

<div class="container py-5"> 
    <div class="card shadow border-0 mx-auto" style="max-width: 800px;">
         
        <div class="card-header bg-info text-white text-center py-3">
            <h4 class="mb-0"><i class="bi bi-megaphone me-2"></i>Nueva Oferta de Empleo</h4>
        </div>

        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                 
                <input type="hidden" asp-for="JobOffer.EmployerId" />
                <input type="hidden" asp-for="JobOffer.CreatedDate" />
                 
                <h5 class="text-secondary border-bottom pb-2 mb-3">Información de la Vacante</h5>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="JobOffer.Title" class="form-label fw-bold">Título de la Posición</label>
                        <input asp-for="JobOffer.Title" class="form-control" placeholder="Desarrollador Unity" />
                        <span asp-validation-for="JobOffer.Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="JobOffer.Salary" class="form-label fw-bold">Salario</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="JobOffer.Salary" class="form-control" placeholder="Ej: 4.500.000" />
                                 
                                <select asp-for="JobOffer.Payment" class="form-select" style="max-width: 150px;">
                                    <option value="1">Mensual</option>
                                    <option value="2">Quincenal</option>
                                </select>
                            </div>
                            <span asp-validation-for="JobOffer.Salary" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="JobOffer.Mode" class="form-label fw-bold">Modalidad</label>
                            <select asp-for="JobOffer.Mode" class="form-select">
                                <option value="">Seleccione...</option>
                                <option value="1">Remoto</option>
                                <option value="2">Presencial</option> 
                            </select>
                            <span asp-validation-for="JobOffer.Mode" class="text-danger small"></span>
                        </div>
                    </div> 
                </div>
                 
                <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">Requisitos y Funciones</h5>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="JobOffer.Description" class="form-label fw-bold">Descripción Detallada</label>
                        <textarea asp-for="JobOffer.Description" class="form-control" rows="6"
                                  placeholder="Una descripción de la vacante..."></textarea>
                        <span asp-validation-for="JobOffer.Description" class="text-danger small"></span>
                    </div>
                </div>
                 
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-info text-white rounded-pill shadow">
                        <i class="bi bi-cloud-upload me-2"></i>Publicar Oferta
                    </button>
                    <a asp-page="/Employer/EDashboard" class="btn btn-link text-muted btn-sm">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}