@page
@model PruebaTecnica.Pages.Employer.EDashboardModel
@{
	ViewData["Title"] = "Panel de la Empresa";
}

<div class="container-fluid" style="height: calc(100vh - 60px); overflow: hidden;">
	<div class="row h-100">
		<div class="col-lg-8 h-100 py-4" style="overflow-y: auto; scrollbar-width: thin;">
			<div class="pe-2">

				<div class="d-flex justify-content-between align-items-center mb-3">
					<div>
						<h5 class="fw-bold m-0">Ofertas Publicadas</h5>
						<span class="text-muted small">He publicado @Model.MyJobs.Count ofertas</span>
					</div>
					<a asp-page="/JobOffers/Create" class="btn btn-success rounded-pill px-4 shadow-sm">
						<i class="bi bi-plus-lg me-1"></i> Publicar Vacante
					</a>
				</div>

				@if (!Model.MyJobs.Any()) {
					<div class="text-center py-5 bg-white rounded shadow-sm border">
						<i class="bi bi-megaphone text-muted display-4"></i>
						<p class="text-muted mt-3">No has publicado vacantes.</p>
					</div>
				}

				@if (Model.MyJobs != null && Model.MyJobs.Count != 0) {
					@foreach (var job in Model.MyJobs) {
						<article class="card shadow-sm border-0 mb-3 hover-shadow" style="transition: 0.3s;">
							<div class="card-body p-4">
								<h4 class="h5 fw-bold mb-1">
									<a href="#" class="text-decoration-none text-dark">@job.Title</a>
								</h4>

								<p class="text-muted mb-2">
									<i class="bi bi-geo-alt me-1"></i>
									@(job.Employer?.Industry ?? "Sin Especificar")
									<span class="mx-3">|</span>
									<i class="bi bi-building me-1"></i>
									<strong>@(job.Employer?.User?.FullName ?? "CONFIDENCIAL")</strong>
									<span class="mx-2">|</span>
									<i class="bi bi-geo-alt me-1"></i>
									@(job.Employer?.Location ?? "Sin Especificar")
								</p>

								<div class="d-flex gap-3 mb-3 text-secondary small">
									<span>
										<i class="bi bi-cash-stack me-1"></i>
										@job.Salary (@(job.Payment == 0 ? "Sin Especificar" : job.Payment.ToString()))
									</span>
									<span class="mx-2">|</span>
									<span>
										<i class="bi bi-laptop me-1"></i>
										@job.Mode
									</span>
								</div>

								<p class="text-secondary small mb-3 text-truncate-2">@job.Description</p>

								<div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
									<span class="text-muted small">
										<i class="bi bi-clock me-1"></i>
										@{
											var timeSpan = DateTime.Now - job.CreatedDate;
											if (timeSpan.TotalDays < 1) {
												if (timeSpan.TotalHours < 1) {
													@($"Hace {Math.Max(1, (int)timeSpan.TotalMinutes)} minutos")
												}
												else {
													@($"Hace {(int)timeSpan.TotalHours} horas")
												}
											}
											else if (timeSpan.TotalDays < 30) {
												@($"Hace {(int)timeSpan.TotalDays} días")
											}
											else {
												@job.CreatedDate.ToString("dd MMM yyyy")
											}
										}
									</span>
								</div><div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
									<span class="text-muted small">
										<i class="bi bi-people-fill me-1 text-primary"></i>
										<strong>@job.Applications.Count</strong> Candidatos interesados
									</span>

									<div class="btn-group">
										<a asp-page="/JobOffers/Applications" asp-route-jobId="@job.Id" class="btn btn-outline-primary btn-sm px-3 rounded-start-pill">
											Ver Postulados
										</a>
										<a asp-page="/JobOffers/Edit" asp-route-id="@job.Id" class="btn btn-primary btn-sm px-3 rounded-end-pill">
											Editar
										</a>
									</div>
								</div>
							</div>
						</article>
					}
				}
			</div>
		</div>

		<div class="col-lg-4 py-4 bg-light border-start">
			<div class="card shadow-sm border-info mb-3">
				<div class="card-body">
					<div class="text-center mb-3">
						<div class="bg-success rounded-circle d-inline-block p-5 mb-2">
							<i class="bi bi-person-fill text-white fs-1"></i>
						</div>
						<h5 class="fw-bold">@Model.Profile.User!.FullName</h5>
						<span class="badge bg-primary rounded-pill">Empresa</span>
					</div>

					<hr />

					<h6><i class="bi bi-info-circle text-center"></i> Información Profesional</h6>
					<ul class="list-group list-group-flush mb-3">
						<li class="list-group-item d-flex justify-content-between align-items-center small">
							Industria:
							<span class="text-muted">@Model.Profile.Industry</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center small">
							Ubicación:
							<span class="text-muted">@Model.Profile.Location</span>
						</li>
						<li class="list-group-item d-flex justify-content-between align-items-center small">
							Empleados:
							<span class="text-muted">@Model.Profile.EmployeeCount</span>
						</li>
					</ul>

					<div class="d-grid gap-2">
						<a asp-page="./Edit" asp-route-id="@Model.Profile.Id" class="btn btn-primary btn-sm px-4 rounded-pill">
							<i class="bi bi-pencil-square"></i> Editar mi perfil
						</a>
						<a asp-page="/Index" class="btn btn-outline-danger btn-sm px-4 rounded-pill">Cerrar Sesión</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>