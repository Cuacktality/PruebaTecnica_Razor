@page
@model PruebaTecnica.Pages.Employer.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>EmployerProfile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EmployerProfile.Id" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="EmployerProfile.UserId" class="control-label"></label>
                <select asp-for="EmployerProfile.UserId" class="form-control" asp-items="ViewBag.UserId" aria-required="true"></select>
                <span asp-validation-for="EmployerProfile.UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="EmployerProfile.Location" class="control-label"></label>
                <input asp-for="EmployerProfile.Location" class="form-control" aria-required="true"/>
                <span asp-validation-for="EmployerProfile.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="EmployerProfile.Industry" class="control-label"></label>
                <input asp-for="EmployerProfile.Industry" class="form-control" aria-required="true"/>
                <span asp-validation-for="EmployerProfile.Industry" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="EmployerProfile.EmployeeCount" class="control-label"></label>
                <input asp-for="EmployerProfile.EmployeeCount" class="form-control" aria-required="true"/>
                <span asp-validation-for="EmployerProfile.EmployeeCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
