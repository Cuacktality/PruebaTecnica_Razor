@page
@model PruebaTecnica.Pages.JobApplications.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>JobApplication</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="JobApplication.SeekerId" class="control-label"></label>
                <select asp-for="JobApplication.SeekerId" class ="form-control" asp-items="ViewBag.SeekerId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="JobApplication.JobOfferId" class="control-label"></label>
                <select asp-for="JobApplication.JobOfferId" class ="form-control" asp-items="ViewBag.JobOfferId" ></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="JobApplication.Status" class="control-label"></label>
                <select asp-for="JobApplication.Status" class="form-control" aria-required="true"></select>
                <span asp-validation-for="JobApplication.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobApplication.AppliedAt" class="control-label"></label>
                <input asp-for="JobApplication.AppliedAt" class="form-control" />
                <span asp-validation-for="JobApplication.AppliedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
