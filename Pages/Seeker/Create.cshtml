@page
@model PruebaTecnica.Pages.Seeker.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>SeekerProfile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
