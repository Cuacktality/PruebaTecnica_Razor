@page
@model PruebaTecnica.Pages.Seeker.EditModel
@{
    ViewData["Title"] = "Perfil del Candidato";
}

<div class="container-fluid bg-white" style="height: calc(100vh - 60px); overflow: hidden;">
    <div class="row h-100">

        <div class="col-lg-8 h-100 py-4" style="overflow-y: auto; scrollbar-width: thin;">
            <div class="container" style="max-width: 700px;">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-page="./Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Editar Perfil</li>
                    </ol>
                </nav>

                <h3 class="fw-bold mb-4">Actualizar mi información</h3>

                <form method="post" class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="SeekerProfile.Id" />
                        <input type="hidden" asp-for="SeekerProfile.UserId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary">Edad</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="SeekerProfile.Age" class="form-control border-start-0 bg-light" placeholder="Ej: 25" />
                                </div>
                                <span asp-validation-for="SeekerProfile.Age" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary text-danger">* Teléfono de Contacto</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="SeekerProfile.ContactNumber" class="form-control border-start-0" />
                                </div>
                                <span asp-validation-for="SeekerProfile.ContactNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary text-danger">* Nivel Educativo</label>
                                <select asp-for="SeekerProfile.ELevel" class="form-select shadow-none">
                                    <option value="">Seleccione...</option>
                                    <option value="Técnico">Técnico</option>
                                    <option value="Tecnólogo">Tecnólogo</option> 
                                    <option value="Universitario">Universitario</option>
                                    <option value="Postgrado">Postgrado</option>
                                </select>
                                <span asp-validation-for="SeekerProfile.ELevel" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary text-danger">* Experiencia Laboral (Años o descripción breve)</label>
                                <textarea asp-for="SeekerProfile.WorkXP" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="SeekerProfile.WorkXP" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold text-secondary">Notas / Habilidades Adicionales</label>
                                <textarea asp-for="SeekerProfile.Notes" class="form-control" rows="3" placeholder="Ej: Conocimientos en .NET, SQL, Trabajo en equipo..."></textarea>
                                <span asp-validation-for="SeekerProfile.Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                            <a asp-page="./Dashboard" class="btn btn-outline-secondary px-4 rounded-pill">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">Guardar Cambios</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4 py-4 bg-light border-start h-100">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-5">
                            <i class="bi bi-person-bounding-box text-primary fs-1"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-0">Vista Previa</h5>
                    <p class="text-muted small">Así se ve tu información profesional</p>
                    <hr />
                    <div class="text-start">
                        <p class="mb-1 small"><strong>Nivel:</strong> @Model.SeekerProfile.ELevel</p>
                        <p class="mb-1 small"><strong>Exp:</strong> @Model.SeekerProfile.WorkXP</p>
                    </div>
                </div>
            </div>

            <div class="card border-danger border-opacity-25 shadow-sm">
                <div class="card-body">
                    <h6 class="text-danger fw-bold mb-2 small"><i class="bi bi-exclamation-triangle-fill"></i> Zona de Peligro</h6>
                    <p class="text-muted" style="font-size: 0.75rem;">Si eliminas tu perfil, perderás todas tus postulaciones activas y no podrás ser contactado por empresas.</p>
                    <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        Eliminar Perfil Definitivamente
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">¿Estás completamente seguro?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-x-circle text-danger display-1"></i>
                <p class="mt-3 text-muted">Esta acción no se puede deshacer. Se borrarán todos tus datos de <strong>@Model.SeekerProfile.User?.FullName</strong>.</p>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">No, mantener perfil</button>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" asp-for="SeekerProfile.Id" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Sí, eliminar todo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}