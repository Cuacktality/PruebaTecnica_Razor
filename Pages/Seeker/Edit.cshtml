@page
@model PruebaTecnica.Pages.Seeker.EditModel
@{
	ViewData["Title"] = "Perfil del Candidato";
}

<div class="container-fluid bg-white" style="height: calc(100vh - 60px); overflow: hidden;">
	<div class="row h-100">

		<div class="col-lg-8 h-100 py-4" style="overflow-y: auto; scrollbar-width: thin;">
			<div class="pe-2 container" style="max-width: 700px;">
				<nav aria-label="breadcrumb" class="mb-4">
					<ol class="breadcrumb small">
						<li class="breadcrumb-item"><a asp-page="./Dashboard" class="text-decoration-none">Dashboard</a></li>
						<li class="breadcrumb-item active text-secondary">Editar mi perfil</li>
					</ol>
				</nav>

				<div class="d-flex align-items-center mb-4">
					<i class="bi bi-pencil-square fs-3 text-primary me-3"></i>
					<h3 class="fw-bold m-0 text-secondary">Información Profesional</h3>
				</div>

				<form method="post" class="card shadow-sm border-0 mb-5">
					<div class="card-body p-4">
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
						<input type="hidden" asp-for="SeekerProfile.Id" />
						<input type="hidden" asp-for="SeekerProfile.UserId" />

						<div class="row g-3">
							<div class="col-md-6">
								<label class="form-label small fw-bold text-secondary">Edad</label>
								<div class="input-group">
									<span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event text-muted"></i></span>
									<input asp-for="SeekerProfile.Age" class="form-control border-start-0 bg-light shadow-none" placeholder="Ej: 25" />
								</div>
								<span asp-validation-for="SeekerProfile.Age" class="text-danger small"></span>
							</div>

							<div class="col-md-6">
								<label class="form-label small fw-bold text-secondary text-danger">* Teléfono de Contacto</label>
								<div class="input-group">
									<span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
									<input asp-for="SeekerProfile.ContactNumber" class="form-control border-start-0 shadow-none" />
								</div>
								<span asp-validation-for="SeekerProfile.ContactNumber" class="text-danger small"></span>
							</div>

							<div class="col-md-12">
								<label class="form-label small fw-bold text-secondary text-danger">* Nivel Educativo</label>
								<div class="input-group">
									<span class="input-group-text bg-light border-end-0"><i class="bi bi-info-circle text-muted"></i></span>
									<select asp-for="SeekerProfile.ELevel" class="form-select border-start-0 shadow-none">
										<option value="">Seleccione su nivel...</option>
										<option value="1">Técnico</option>
										<option value="2">Tecnólogo</option>
										<option value="3">Universitario</option>
										<option value="4">Postgrado</option>
									</select>
								</div>
								<span asp-validation-for="SeekerProfile.ELevel" class="text-danger small"></span>
							</div>

							<div class="col-md-12">
								<label class="form-label small fw-bold text-secondary text-danger">* Experiencia (Breve resumen)</label>
								<textarea asp-for="SeekerProfile.WorkXP" class="form-control shadow-none" rows="3" placeholder="Describe tus años de experiencia y cargos..."></textarea>
								<span asp-validation-for="SeekerProfile.WorkXP" class="text-danger small"></span>
							</div>

							<div class="col-md-12">
								<label class="form-label small fw-bold text-secondary">Notas / Habilidades Adicionales</label>
								<textarea asp-for="SeekerProfile.Notes" class="form-control shadow-none" rows="3" placeholder="Ej: Conocimientos en .NET, SQL, Trabajo en equipo..."></textarea>
								<span asp-validation-for="SeekerProfile.Notes" class="text-danger small"></span>
							</div>
						</div>

						<div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
							<a asp-page="./Dashboard" class="btn btn-outline-secondary px-4 rounded-pill btn-sm">Cancelar</a>
							<button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm btn-sm">
								<i class="bi bi-check-lg me-1"></i> Guardar Cambios
							</button>
						</div>
					</div>
				</form>
			</div>
		</div>

		<div class="col-lg-4 py-4 bg-light border-start h-100">
			<div class="h-100 pe-2" style="overflow-y: auto; scrollbar-width: thin;">

				<div class="card shadow-sm border-info mb-3">
					<div class="card-body">
						<div class="text-center mb-3">
							<div class="bg-success rounded-circle d-inline-block p-5 mb-2 shadow-sm">
								<i class="bi bi-person-fill text-white fs-1"></i>
							</div>
							<h5 class="fw-bold">@Model.SeekerProfile.User?.FullName</h5>
							<span class="badge bg-secondary rounded-pill">Vista Previa</span>
						</div>

						<hr />

						<h6><i class="bi bi-info-circle text-center"></i> Información Profesional</h6>
						<ul class="list-group list-group-flush mb-3">
							<li class="list-group-item d-flex justify-content-between align-items-center small bg-transparent">
								Experiencia:
								<span class="text-muted fw-bold">@Model.SeekerProfile.WorkXP</span>
							</li>
							<li class="list-group-item d-flex justify-content-between align-items-center small bg-transparent">
								Nivel Educativo:
								<span class="text-muted fw-bold">@Model.SeekerProfile.ELevel</span>
							</li>
						</ul>
					</div>

					<div class="card-body bg-white border-top">
						<h6 class="fw-bold mb-3 text-danger small"><i class="bi bi-exclamation-triangle-fill me-2"></i>Zona de Peligro</h6>
						<p class="text-muted mb-3" style="font-size: 0.75rem;">
							Al eliminar tu perfil, se cancelarán todas tus postulaciones y los empleadores dejarán de ver tu hoja de vida.
						</p>
						<button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#deleteModal">
							Eliminar mi cuenta definitivamente
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<div class="modal-header border-0">
				<h5 class="modal-title fw-bold text-danger">Confirmar eliminación</h5>
				<button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body text-center py-4">
				<div class="mb-3">
					<i class="bi bi-trash3 text-danger display-3"></i>
				</div>
				<p class="text-muted">¿Estás seguro de que deseas eliminar tu perfil profesional de nuestra plataforma? Esta acción es irreversible.</p>
			</div>
			<div class="modal-footer border-0 bg-light">
				<button type="button" class="btn btn-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Mantener perfil</button>
				<form method="post" asp-page-handler="Delete">
					<input type="hidden" asp-for="SeekerProfile.Id" />
					<button type="submit" class="btn btn-danger rounded-pill px-4 btn-sm">Sí, eliminar ahora</button>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}